{
  "name": "@vtable-guild/vtable-guild",
  "version": "2.0.4",
  "description": "A highly customizable Vue 3 Table component library powered by tailwind-variants",
  "type": "module",
  "files": [
    "dist",
    "css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./css": {
      "style": "./css/index.css",
      "default": "./css/index.css"
    },
    "./css/tokens": {
      "style": "./css/tokens.css",
      "default": "./css/tokens.css"
    },
    "./css/transitions": {
      "style": "./css/transitions.css",
      "default": "./css/transitions.css"
    },
    "./css/presets/antdv": {
      "style": "./css/presets/antdv.css",
      "default": "./css/presets/antdv.css"
    },
    "./css/presets/element-plus": {
      "style": "./css/presets/element-plus.css",
      "default": "./css/presets/element-plus.css"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && node ./scripts/copy-theme-css.mjs",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --project ./tsconfig.build.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project vtable-guild --passWithNoTests",
    "prepublishOnly": "node -e \"if(!require('fs').existsSync('dist'))throw new Error('dist not found, run pnpm build first')\""
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "author": "parade0393",
  "repository": {
    "type": "git",
    "url": "https://github.com/parade0393/vtable-guild",
    "directory": "packages/vtable-guild"
  },
  "homepage": "https://github.com/parade0393/vtable-guild#readme",
  "bugs": {
    "url": "https://github.com/parade0393/vtable-guild/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "table",
    "component",
    "tailwind",
    "ant-design-vue",
    "element-plus",
    "customizable"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
