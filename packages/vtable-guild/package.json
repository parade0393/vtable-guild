{
  "name": "@vtable-guild/vtable-guild",
  "version": "1.0.1",
  "description": "A highly customizable Vue 3 Table component library powered by tailwind-variants",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --build",
    "test": "vitest run --config ../../vitest.config.ts --project vtable-guild --passWithNoTests"
  },
  "dependencies": {
    "@vtable-guild/core": "workspace:*",
    "@vtable-guild/icons": "workspace:*",
    "@vtable-guild/theme": "workspace:*",
    "@vtable-guild/table": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "author": "parade0393",
  "repository": {
    "type": "git",
    "url": "https://github.com/parade0393/vtable-guild",
    "directory": "packages/vtable-guild"
  },
  "homepage": "https://github.com/parade0393/vtable-guild#readme",
  "bugs": {
    "url": "https://github.com/parade0393/vtable-guild/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "table",
    "component",
    "tailwind",
    "ant-design-vue",
    "element-plus",
    "customizable"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
