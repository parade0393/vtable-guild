{
  "name": "@vtable-guild/core",
  "version": "2.0.3",
  "private": true,
  "description": "Core utilities and theme system for vtable-guild",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
