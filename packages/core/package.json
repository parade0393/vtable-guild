  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --build",
    "test": "vitest run --config ../../vitest.config.ts --project core"
  },
  "dependencies": {
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2"
