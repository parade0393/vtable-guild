{
  "name": "@vtable-guild/icons",
  "version": "1.0.2",
  "description": "SVG icon components for vtable-guild",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --build",
    "test": "vitest run --config ../../vitest.config.ts --project icons --passWithNoTests",
    "prepublishOnly": "node -e \"if(!require('fs').existsSync('dist'))throw new Error('dist not found, run pnpm build first')\""
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "author": "parade0393",
  "repository": {
    "type": "git",
    "url": "https://github.com/parade0393/vtable-guild",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/parade0393/vtable-guild#readme",
  "bugs": {
    "url": "https://github.com/parade0393/vtable-guild/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "icons",
    "svg",
    "table"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
