{
  "name": "@vtable-guild/theme",
  "version": "2.0.1",
  "description": "Default theme definitions for vtable-guild",
  "type": "module",
  "files": [
    "dist",
    "css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./css": "./css/index.css",
    "./css/tokens": "./css/tokens.css",
    "./css/presets/antdv": "./css/presets/antdv.css",
    "./css/presets/element-plus": "./css/presets/element-plus.css"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --build",
    "test": "vitest run --config ../../vitest.config.ts --project theme",
    "prepublishOnly": "node -e \"if(!require('fs').existsSync('dist'))throw new Error('dist not found, run pnpm build first')\""
  },
  "devDependencies": {
    "@vtable-guild/core": "workspace:*"
  },
  "author": "parade0393",
  "repository": {
    "type": "git",
    "url": "https://github.com/parade0393/vtable-guild",
    "directory": "packages/theme"
  },
  "homepage": "https://github.com/parade0393/vtable-guild#readme",
  "bugs": {
    "url": "https://github.com/parade0393/vtable-guild/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "table",
    "theme",
    "tailwind",
    "css",
    "preset"
  ],
  "sideEffects": [
    "css/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
